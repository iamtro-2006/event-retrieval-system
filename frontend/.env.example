# WARNING: every VITE_* value is exposed in the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Each media type can have its own HTTP server. {DATASET} becomes AIC or CAM;
# {dataset} becomes aic or cam. The API's image_rel_path/video_rel_path/map_rel_path
# is appended to each base URL.
# Example: local keyframes/maps and videos hosted by another machine:
# VITE_KEYFRAMES_BASE_URL=http://127.0.0.1:3174/{DATASET}/keyframes
# VITE_VIDEOS_BASE_URL=https://videos.example.org/{DATASET}/videos
# VITE_MAP_KEYFRAMES_BASE_URL=http://127.0.0.1:3174/{DATASET}/map-keyframes
VITE_KEYFRAMES_BASE_URL=
VITE_VIDEOS_BASE_URL=
VITE_MAP_KEYFRAMES_BASE_URL=

# Optional overrides when AIC and CAM use different servers or layouts.
# These take priority over the three shared media URLs above.
# VITE_CAM_VIDEOS_BASE_URL=https://cam.example.org/videos
VITE_AIC_KEYFRAMES_BASE_URL=
VITE_CAM_KEYFRAMES_BASE_URL=
VITE_AIC_VIDEOS_BASE_URL=
VITE_CAM_VIDEOS_BASE_URL=
VITE_AIC_MAP_KEYFRAMES_BASE_URL=
VITE_CAM_MAP_KEYFRAMES_BASE_URL=

# Legacy single data root. Used only for media types without a URL above.
VITE_DATA_BASE_URL=

# Optional. Restrict this key by HTTP referrer and Cloud Translation API.
VITE_GOOGLE_TRANSLATE=

# Optional DRES integration. Never commit real credentials.
VITE_SUBMISSION=
VITE_TEAM_ID=
VITE_TEAM_PASSWORD=
VITE_DRES_EVALUATION_ID=

# Independent verified-result relay, e.g. https://relay.example.com
VITE_GODMODE_ENDPOINT=
# Backward-compatible alias if your deployment already uses this name:
# VITE_SOCKET_URL=https://relay.example.com

VITE_DEBUG_API_RESPONSES=false
