# WARNING: every VITE_* value is exposed in the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Each URL points to the directory containing AIC/, CAM/, etc. The frontend
# appends /{DATASET}/ and then the relative path returned by the API.
# These can be three different hosts. Leave a URL empty to use the local API.
# Example: VITE_VIDEOS_BASE_URL=http://another-host.example:8000/videos
# Local API serves these URLs when data/<kind>/<DATASET>/ exists.
VITE_KEYFRAMES_BASE_URL=http://127.0.0.1:8000/keyframes
VITE_VIDEOS_BASE_URL=http://127.0.0.1:8000/videos
VITE_MAP_KEYFRAMES_BASE_URL=http://127.0.0.1:8000/mapkeyframes

# Optional. Restrict this key by HTTP referrer and Cloud Translation API.
VITE_GOOGLE_TRANSLATE=

# Optional DRES integration. Never commit real credentials.
VITE_SUBMISSION=
VITE_TEAM_ID=
VITE_TEAM_PASSWORD=
VITE_DRES_EVALUATION_ID=

# Independent verified-result relay, e.g. https://relay.example.com
VITE_GODMODE_ENDPOINT=
# Backward-compatible alias if your deployment already uses this name:
# VITE_SOCKET_URL=https://relay.example.com

VITE_DEBUG_API_RESPONSES=false
