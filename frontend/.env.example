# WARNING: every VITE_* value is exposed in the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Leave static base URLs empty when FastAPI serves local files.
VITE_KEYFRAMES_BASE_URL=
VITE_VIDEOS_BASE_URL=
VITE_MAP_KEYFRAMES_BASE_URL=

# Optional. Restrict this key by HTTP referrer and Cloud Translation API.
VITE_GOOGLE_TRANSLATE=

# Optional DRES integration. Never commit real credentials.
VITE_SUBMISSION=
VITE_TEAM_ID=
VITE_TEAM_PASSWORD=
VITE_DRES_EVALUATION_ID=

VITE_DEBUG_API_RESPONSES=false
