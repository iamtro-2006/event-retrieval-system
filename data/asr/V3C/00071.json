  {
    "video_id": "00071",
    "start": 162.97,
    "end": 163.49,
    "transcript": "Bonjour."
  },
  {
    "video_id": "00071",
    "start": 169.49,
    "end": 171.07,
    "transcript": "C'est pas la grève, aujourd'hui, hein ?"
  },
  {
    "video_id": "00071",
    "start": 184.56,
    "end": 186.14,
    "transcript": "J'y vais pour voir, j'y vais en quart."
  },
  {
    "video_id": "00071",
    "start": 186.14,
    "end": 188.82,
    "transcript": "C'est pour détendre."
  },
  {
    "video_id": "00071",
    "start": 189.46,
    "end": 190.28,
    "transcript": "Oui, oui, j'avais compris."
  },
  {
    "video_id": "00071",
    "start": 199.26,
    "end": 201.66,
    "transcript": "Ce soir, le ciel est dépeuplé, car toutes les étoiles sont dans tes yeux."
