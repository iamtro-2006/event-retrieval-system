  {
    "video_id": "00071",
    "start": 66.35,
    "end": 68.13,
    "transcript": "Non, c'est un pote comédien."
  },
  {
    "video_id": "00071",
    "start": 68.75,
    "end": 71.11,
    "transcript": "Et en fait, on voulait te payer une dernière drague avant ton mariage."
  },
  {
    "video_id": "00071",
    "start": 71.83,
    "end": 74.09,
    "transcript": "Bah voilà, elle est furaque, ça, je te l'avais dit, je la connais par cœur."
  },
  {
    "video_id": "00071",
    "start": 74.31,
    "end": 76.27,
    "transcript": "Ça, c'est quand même plus rigolo qu'un vulgaire internement de vie de jeune fille."
  },
  {
    "video_id": "00071",
    "start": 76.27,
    "end": 76.81,
    "transcript": "Bah oui."
  },
  {
    "video_id": "00071",
    "start": 76.81,
    "end": 79.21,
    "transcript": "Mais quelle bande de salopes !"
  },
  {
    "video_id": "00071",
    "start": 79.21,
    "end": 81.47,
    "transcript": "Alors, ça a marché, hein ? Il s'est passé quelque chose ?"
  },
  {
    "video_id": "00071",
    "start": 81.47,
    "end": 82.61,
    "transcript": "Ouais, ouais, ouais, ça a marché à fond, là."
  },
  {
    "video_id": "00071",
    "start": 83.43,
    "end": 85.57,
    "transcript": "Bon, bah écoute, maintenant, je peux te la présenter officiellement."
  },
  {
    "video_id": "00071",
    "start": 85.69,
    "end": 87.79,
    "transcript": "Voilà, Sonia, c'est mon pote."
