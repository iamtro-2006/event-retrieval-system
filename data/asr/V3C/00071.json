    "end": 11.73,
    "transcript": "Vous croyez que..."
  },
  {
    "video_id": "00071",
    "start": 11.73,
    "end": 13.43,
    "transcript": "Que quoi ?"
  },
  {
    "video_id": "00071",
    "start": 13.43,
    "end": 14.93,
    "transcript": "Rien, rien, c'est ridicule."
  },
  {
    "video_id": "00071",
    "start": 15.57,
    "end": 16.75,
    "transcript": "Mais si, si, si, dites, dites."
  },
  {
    "video_id": "00071",
    "start": 18.39,
    "end": 19.55,
    "transcript": "Je vous souhaite beaucoup de bonheur."
  },
  {
    "video_id": "00071",
    "start": 21.01,
    "end": 21.95,
    "transcript": "Je vous entends pas."
  },
  {
    "video_id": "00071",
    "start": 30.38,
    "end": 30.9,
    "transcript": "Ah bah crevant."
  },
  {
    "video_id": "00071",
    "start": 31.96,
    "end": 32.76,
    "transcript": "C'est tout ?"
  },
  {
    "video_id": "00071",
    "start": 32.76,
    "end": 33.08,
    "transcript": "Bah oui."
  },
  {
    "video_id": "00071",
    "start": 33.58,
    "end": 34.96,
    "transcript": "Y a rien d'autre ? T'es rien arrivé d'autre ?"
  },
  {
    "video_id": "00071",
    "start": 34.96,
    "end": 37.92,
    "transcript": "Bah sinon, à part une claustro, puis un jeune mec qui avait jamais vu la tour Eiffel,"
  },
  {
    "video_id": "00071",
    "start": 37.98,
    "end": 39.18,
    "transcript": "mais à part ça, rien d'extraordinaire."
  },
  {
    "video_id": "00071",
    "start": 40.26,
    "end": 41.74,
    "transcript": "Ça va, là ? T'as l'air un petit peu bizarre."
  },
  {
    "video_id": "00071",
    "start": 42.06,
    "end": 42.68,
    "transcript": "Non, non, ça va."
  },
  {
    "video_id": "00071",
    "start": 43.44,
    "end": 45.5,
    "transcript": "Tu y crois pas ? Elle a craqué, elle a."
  },
  {
    "video_id": "00071",
    "start": 47.89,
    "end": 48.21,
    "transcript": "Craqué."
  },
  {
    "video_id": "00071",
    "start": 49.15,
    "end": 51.91,
    "transcript": "Sur le mec dans le bus ?"
  },
  {
    "video_id": "00071",
    "start": 51.91,
    "end": 53.77,
    "transcript": "Non, attendez, moi, j'étais pas d'accord au départ."
  },
  {
    "video_id": "00071",
    "start": 54.01,
    "end": 55.39,
    "transcript": "C'est son idée, si."
  },
  {
    "video_id": "00071",
    "start": 55.61,
    "end": 56.47,
    "transcript": "Bah non, et où ?"
  },
  {
    "video_id": "00071",
    "start": 56.47,
    "end": 58.89,
    "transcript": "Hélène, c'est quoi cette histoire de mec dans le bus ?"
  },
  {
    "video_id": "00071",
    "start": 58.89,
    "end": 60.65,
    "transcript": "Bah, y a un mec qui s'est assis à côté de toi dans le bus."
  },
  {
    "video_id": "00071",
    "start": 61.23,
    "end": 61.45,
    "transcript": "Oui."
  },
  {
    "video_id": "00071",
    "start": 62.19,
    "end": 64.41,
    "transcript": "Sympa, plein de charme, rigolo."
  },
  {
    "video_id": "00071",
    "start": 64.79,
    "end": 65.31,
    "transcript": "Et bah c'est un pro."
  },
  {
    "video_id": "00071",
    "start": 65.59,
    "end": 66.15,
    "transcript": "Non, c'est pas un pro."
