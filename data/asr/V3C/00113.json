  {
    "video_id": "00113",
    "start": 484.55,
    "end": 486.55,
    "transcript": "Statično, ja, ono tip se pričvrsti."
  },
  {
    "video_id": "00113",
    "start": 486.55,
    "end": 488.55,
    "transcript": "Nekaj pa je na kitarji."
  },
  {
    "video_id": "00113",
    "start": 488.55,
