    "end": 432.55,
    "transcript": "Fak."
  },
  {
    "video_id": "00113",
    "start": 432.55,
    "end": 434.55,
    "transcript": "Od 23. do 24. uri."
  },
  {
    "video_id": "00113",
    "start": 434.55,
    "end": 436.55,
    "transcript": "Ja, ja, ja, pa po mikrofonu se je malo potresel."
  },
  {
    "video_id": "00113",
    "start": 436.55,
    "end": 438.55,
    "transcript": "Kasteljic te bo nekaj naredil."
  },
  {
    "video_id": "00113",
    "start": 438.55,
    "end": 440.55,
    "transcript": "Kasteljic te bo nekaj naredil."
  },
  {
    "video_id": "00113",
    "start": 440.55,
    "end": 442.55,
    "transcript": "To je zato, ker ni pepelni kranja."
  },
  {
    "video_id": "00113",
    "start": 442.55,
    "end": 444.55,
    "transcript": "Kaj je zmeranje pepelnih odmesev?"
  },
  {
    "video_id": "00113",
    "start": 444.55,
    "end": 446.55,
    "transcript": "Kaj ne podotresa?"
  },
  {
    "video_id": "00113",
    "start": 446.55,
    "end": 448.55,
    "transcript": "Čez okn."
  },
  {
    "video_id": "00113",
    "start": 448.55,
    "end": 450.55,
    "transcript": "Ja, veš, koliko je dala čakaj?"
  },
  {
    "video_id": "00113",
    "start": 450.55,
    "end": 452.55,
    "transcript": "Šetaj."
  },
  {
    "video_id": "00113",
    "start": 452.55,
    "end": 454.55,
    "transcript": "Od 23. do 24. uri,"
  },
  {
    "video_id": "00113",
    "start": 454.55,
    "end": 456.55,
    "transcript": "lisem kranj, čeloti, trepetoni,"
  },
  {
    "video_id": "00113",
    "start": 456.55,
    "end": 458.55,
    "transcript": "karovic, uživo,"
  },
  {
    "video_id": "00113",
    "start": 458.55,
    "end": 460.55,
    "transcript": "naodro, kuda,"
  },
  {
    "video_id": "00113",
