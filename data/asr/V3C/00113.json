    "end": 462.55,
    "transcript": "ginseda v polnoči,"
  },
  {
    "video_id": "00113",
    "start": 462.55,
    "end": 464.55,
    "transcript": "vis, carina."
  },
  {
    "video_id": "00113",
    "start": 464.55,
    "end": 466.55,
    "transcript": "To bo nebolj uživo na radište,"
