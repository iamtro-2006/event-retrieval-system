  {
    "video_id": "00113",
    "start": 952.9,
    "end": 956.9,
    "transcript": "To si ti meni, kaj bo ti meni odjaki, pa ono, pa ono."
  },
  {
    "video_id": "00113",
    "start": 956.9,
    "end": 961.49,
    "transcript": "Ja, imam še enega."
  },
  {
    "video_id": "00113",
    "start": 961.49,
    "end": 965.49,
    "transcript": "Mogoče te me sliša, nekaj. A ti njega slišaš?"
  },
  {
    "video_id": "00113",
    "start": 965.49,
    "end": 967.49,
    "transcript": "A ga slišaš, kaj govori?"
  },
  {
    "video_id": "00113",
    "start": 967.49,
    "end": 969.49,
    "transcript": "Ja, slišam."
  },
  {
    "video_id": "00113",
    "start": 969.49,
    "end": 972.49,
    "transcript": "Če ga slišaš, ponavadi, mislim, kar zdaj mu povedi?"
  },
  {
    "video_id": "00113",
    "start": 972.49,
    "end": 975.49,
    "transcript": "Zato pa sliša."
  },
  {
    "video_id": "00113",
    "start": 975.49,
    "end": 979.49,
    "transcript": "Zato on ima opcijo, da te tudi ne sliši."
  },
  {
    "video_id": "00113",
    "start": 979.49,
    "end": 984.49,
    "transcript": "Ja, ja, ja."
  },
  {
    "video_id": "00113",
    "start": 984.49,
    "end": 996.48,
    "transcript": "Kaj pa v tem meni odjaki? Ne, nimam pa več. Ne. Zdaj pa ono."
  },
  {
    "video_id": "00113",
    "start": 1018.65,
    "end": 1029.31,
    "transcript": "Vdeležencem smo postavili tudi naslednje vprašanje."
  },
  {
    "video_id": "00113",
    "start": 1029.31,
    "end": 1032.31,
    "transcript": "Odjevanj kantirovcev je bil pozitiven"
  },
  {
    "video_id": "00113",
    "start": 1032.31,
    "end": 1036.31,
    "transcript": "in se veselijo naslednjega sodelovanja z Radijem Cirkus."
  },
  {
    "video_id": "00113",
    "start": 1036.31,
    "end": 1051.0,
    "transcript": "Naslednja oddaja bo naslednji četrtek v 8. uri zveče."
  },
  {
    "video_id": "00113",
    "start": 1051.0,
    "end": 1057.0,
    "transcript": "Poslušalci ste oddajali anketa Radija Cirkus, ki so jo pripravili."
  },
  {
    "video_id": "00113",
    "start": 1057.0,
    "end": 1062.44,
    "transcript": "Še enega. Poslušali ste?"
  },
  {
    "video_id": "00113",
    "start": 1062.44,
    "end": 1067.44,
    "transcript": "Poslušali ste oddajo anketa Radija Cirkus, ki so jo pripravili"
  },
  {
    "video_id": "00113",
    "start": 1067.44,
    "end": 1070.44,
    "transcript": "novinarja Jakob Zelinka in Mitja Kmetič,"
  },
  {
    "video_id": "00113",
    "start": 1070.44,
    "end": 1074.44,
    "transcript": "glasbeni upremljavalec Mojmir Maurič,"
  },
  {
    "video_id": "00113",
    "start": 1074.44,
    "end": 1077.44,
    "transcript": "bralka Toni in Katja"
  },
  {
    "video_id": "00113",
    "start": 1077.44,
    "end": 1081.44,
    "transcript": "in tehnična izvedba Tim, Blaž in pa Sašo."
  },
  {
    "video_id": "00113",
    "start": 1081.44,
    "end": 1084.44,
    "transcript": "Postanite še naprej na Radiju Cirkus."
  },
  {
    "video_id": "00113",
    "start": 1086.44,
    "end": 1088.44,
    "transcript": "Še enkrat, kar je bilo bralka, ne bral..."
  },
  {
    "video_id": "00113",
    "start": 1088.44,
    "end": 1091.75,
    "transcript": "Bralastva, reči, bralastva."
  },
  {
    "video_id": "00113",
    "start": 1091.75,
    "end": 1095.92,
    "transcript": "Ne, sem ta odstavna."
  },
  {
    "video_id": "00113",
    "start": 1095.92,
    "end": 1097.92,
    "transcript": "Bralastva."
  },
  {
    "video_id": "00113",
    "start": 1097.92,
    "end": 1104.7,
    "transcript": "Bralastva, Toni in Katja."
  },
  {
    "video_id": "00113",
    "start": 1104.7,
    "end": 1116.31,
    "transcript": "Mislim, ti mora on povedat, od kje je te nuta, ne?"
  },
  {
    "video_id": "00113",
    "start": 1116.31,
    "end": 1118.31,
    "transcript": "Glasbeni upremljavalec Mojmir Maurič,"
  },
  {
    "video_id": "00113",
    "start": 1118.31,
    "end": 1121.31,
    "transcript": "brala sva Toni in Katja,"
  },
  {
    "video_id": "00113",
    "start": 1121.31,
    "end": 1126.31,
    "transcript": "za tehnično izvedbo so poskrbeli Blaž, Tim in pa Sašo."
  },
  {
    "video_id": "00113",
