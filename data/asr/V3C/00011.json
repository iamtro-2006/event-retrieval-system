    "transcript": "Est-ce la graisse anglo-saxonne"
  },
  {
    "video_id": "00011",
    "start": 47.37,
    "end": 49.67,
    "transcript": "De ma cambrure"
  },
  {
    "video_id": "00011",
    "start": 49.67,
    "end": 51.89,
    "transcript": "Est-ce mon sourire"
  },
  {
    "video_id": "00011",
    "start": 51.89,
    "end": 55.65,
    "transcript": "Ou bien l'élégance distinguée"
  },
  {
    "video_id": "00011",
    "start": 55.65,
    "end": 57.65,
    "transcript": "De mes cachemires"
  },
  {
    "video_id": "00011",
    "start": 57.65,
    "end": 59.65,
    "transcript": "Quoi qu'il en soit"
  },
  {
    "video_id": "00011",
    "start": 59.65,
    "end": 63.84,
    "transcript": "Le plus beau du quartier"
  },
  {
    "video_id": "00011",
    "start": 63.84,
    "end": 68.32,
    "transcript": "Mais prenez garde à ma beauté"
  },
  {
    "video_id": "00011",
    "start": 68.32,
    "end": 70.9,
    "transcript": "Et à mon exquise ambiguïté"
  },
  {
    "video_id": "00011",
    "start": 70.9,
    "end": 72.18,
    "transcript": "Je suis le roi"
  },
  {
    "video_id": "00011",
