    "end": 1.38,
    "transcript": "Regardez-moi"
  },
  {
    "video_id": "00011",
    "start": 1.38,
    "end": 5.74,
    "transcript": "Je suis le plus beau du quartier"
  },
  {
    "video_id": "00011",
    "start": 5.74,
    "end": 8.04,
    "transcript": "Je suis le bien-aimé"
  },
  {
    "video_id": "00011",
    "start": 8.04,
    "end": 9.96,
    "transcript": "Dès qu'on me voit"
  },
  {
    "video_id": "00011",
    "start": 9.96,
    "end": 13.96,
    "transcript": "Je sens tout comme envoûté"
  },
  {
    "video_id": "00011",
    "start": 13.96,
    "end": 15.62,
    "transcript": "Comme charmé"
  },
  {
    "video_id": "00011",
    "start": 16.4,
    "end": 18.42,
    "transcript": "Lorsque j'arrive"
  },
  {
    "video_id": "00011",
    "start": 18.42,
    "end": 22.54,
    "transcript": "Les femmes, elles me frôlent au-delà"
  },
  {
    "video_id": "00011",
    "start": 22.54,
    "end": 24.98,
    "transcript": "Regards penchés"
  },
  {
    "video_id": "00011",
    "start": 24.98,
    "end": 27.04,
    "transcript": "Bien malgré moi, oui"
  },
  {
    "video_id": "00011",
    "start": 27.04,
    "end": 30.46,
    "transcript": "Le plus beau du quartier"
  },
  {
    "video_id": "00011",
    "start": 33.12,
    "end": 35.26,
    "transcript": "Est-ce mon visage"
  },
  {
    "video_id": "00011",
    "start": 35.26,
    "end": 38.95,
    "transcript": "Aussi finement grainé"
  },
  {
    "video_id": "00011",
    "start": 38.95,
    "end": 41.35,
    "transcript": "Mon air suave"
  },
  {
    "video_id": "00011",
    "start": 41.35,
    "end": 43.25,
    "transcript": "Est-ce mon allure"
  },
  {
    "video_id": "00011",
    "start": 43.25,
