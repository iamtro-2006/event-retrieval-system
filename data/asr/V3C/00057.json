  {
    "video_id": "00057",
    "start": 498.92,
    "end": 500.92,
    "transcript": "Das hat der Trainer gehabt."
  },
  {
    "video_id": "00057",
    "start": 500.92,
    "end": 502.92,
    "transcript": "Jetzt beim Landeplatz schaut es aus,"
