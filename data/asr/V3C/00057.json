  {
    "video_id": "00057",
    "start": 543.58,
    "end": 545.58,
    "transcript": "So sieht es in Österreich aus."
  },
  {
    "video_id": "00057",
    "start": 545.58,
    "end": 547.58,
    "transcript": "Ich habe mich gefreut,"
  },
  {
    "video_id": "00057",
    "start": 547.58,
    "end": 549.58,
    "transcript": "dass wir uns wieder getroffen haben."
