  {
    "video_id": "00057",
    "start": 383.8,
    "end": 401.32,
    "transcript": "Wegen dem Panorama fahren wir hier runter."
  },
  {
    "video_id": "00057",
    "start": 401.32,
    "end": 403.32,
    "transcript": "Jetzt sind wir schon wieder auf 3,52 m."
  },
  {
    "video_id": "00057",
    "start": 403.32,
    "end": 485.71,
    "transcript": "Wir sind vorbei, weil das ist schon alt angeschaut."
  },
  {
    "video_id": "00057",
    "start": 485.71,
    "end": 489.98,
    "transcript": "Mit Max unterwegs."
  },
  {
    "video_id": "00057",
    "start": 489.98,
    "end": 493.32,
    "transcript": "Endanflug."
  },
  {
    "video_id": "00057",
    "start": 493.32,
    "end": 496.92,
    "transcript": "Das war ein super spannender Endanflug."
  },
  {
    "video_id": "00057",
    "start": 496.92,
    "end": 498.92,
    "transcript": "Viel Gas, Südostpfotzen."
