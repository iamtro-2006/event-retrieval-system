[
  {
    "video_id": "00057",
    "start": 202.86,
    "end": 205.76,
    "transcript": "Wo noch will man das?"
  },
  {
    "video_id": "00057",
    "start": 205.76,
    "end": 234.52,
    "transcript": "Das ist mir natürlich gut auszusehen."
  },
  {
    "video_id": "00057",
    "start": 234.52,
    "end": 238.52,
    "transcript": "Ich glaube, ich war überhaupt noch nie oder zumindest schon lange nicht mehr."
  },
  {
    "video_id": "00057",
    "start": 238.52,
    "end": 240.52,
    "transcript": "Da hat es mir dann super schön geholfen."
  },
  {
    "video_id": "00057",
    "start": 240.52,
    "end": 242.52,
    "transcript": "Die Hofe ist relativ nah und weiter ein bisschen."
  },
  {
    "video_id": "00057",
    "start": 242.52,
    "end": 244.52,
    "transcript": "Da sind überentwickelt."
  },
  {
    "video_id": "00057",
    "start": 244.52,
    "end": 246.52,
    "transcript": "Das passt auch nicht."
  },
  {
    "video_id": "00057",
    "start": 246.52,
    "end": 248.52,
    "transcript": "Das sieht super aus."
  },
  {
    "video_id": "00057",
    "start": 248.52,
    "end": 278.14,
    "transcript": "Da muss ich nicht weiterkommen."
  },
  {
    "video_id": "00057",
    "start": 278.14,
    "end": 301.68,
    "transcript": "Das ist so ein Panorama."
  },
  {
    "video_id": "00057",
    "start": 301.68,
    "end": 303.68,
    "transcript": "Die Basis ist ungefähr auf 3,4 m."
  },
  {
    "video_id": "00057",
    "start": 303.68,
    "end": 305.68,
    "transcript": "Wenn man es probieren will, zum Ziel."
  },
  {
    "video_id": "00057",
    "start": 305.68,
    "end": 330.84,
    "transcript": "Viel Mitte im Wolken."
  },
  {
    "video_id": "00057",
    "start": 330.84,
    "end": 332.84,
    "transcript": "Das wird nicht fahren."
  },
  {
    "video_id": "00057",
    "start": 332.84,
    "end": 352.73,
    "transcript": "Das ist gut. Kurz vor 16."
  },
  {
    "video_id": "00057",
    "start": 352.73,
    "end": 354.73,
    "transcript": "3.370 m."
  },
  {
    "video_id": "00057",
    "start": 354.73,
    "end": 374.88,
    "transcript": "Das muss man können."
  },
  {
    "video_id": "00057",
    "start": 374.88,
    "end": 378.8,
    "transcript": "Das hat er schon angeschaut."
  },
  {
    "video_id": "00057",
    "start": 378.8,
    "end": 383.8,
    "transcript": "Da kann ich nicht mehr sein."
