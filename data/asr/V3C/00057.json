  {
    "video_id": "00057",
    "start": 504.92,
    "end": 506.92,
    "transcript": "Passt eh genau."
  },
  {
    "video_id": "00057",
    "start": 506.92,
    "end": 508.92,
    "transcript": "10 nach 8."
  },
  {
    "video_id": "00057",
    "start": 508.92,
    "end": 510.92,
    "transcript": "4 nach 8, wenn wir absitzen."
  },
