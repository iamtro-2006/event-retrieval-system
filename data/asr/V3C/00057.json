  {
    "video_id": "00057",
    "start": 614.06,
    "end": 616.06,
    "transcript": "Butterwacht zum Fliegen."
  },
  {
    "video_id": "00057",
    "start": 616.06,
    "end": 618.06,
    "transcript": "Die Basis ist ein wenig tiefer."
