  {
    "video_id": "00057",
    "start": 516.92,
    "end": 521.58,
    "transcript": "Max nach 10,5 Stunden."
  },
  {
    "video_id": "00057",
    "start": 521.58,
    "end": 523.58,
    "transcript": "Wie fühlst du dich?"
  },
  {
    "video_id": "00057",
    "start": 523.58,
    "end": 525.58,
    "transcript": "Gut."
  },
  {
    "video_id": "00057",
    "start": 525.58,
    "end": 527.58,
    "transcript": "Als ich gerade losgestartet war,"
  },
  {
    "video_id": "00057",
    "start": 527.58,
    "end": 529.58,
    "transcript": "es war heute ein genialer Tag."
  },
  {
    "video_id": "00057",
    "start": 529.58,
    "end": 531.58,
    "transcript": "Es war super."
  },
  {
    "video_id": "00057",
    "start": 531.58,
    "end": 533.58,
    "transcript": "Fein zum Fliegen."
  },
  {
    "video_id": "00057",
    "start": 533.58,
    "end": 535.58,
    "transcript": "Die ersten Schenkel waren ein bisschen mühsam."
