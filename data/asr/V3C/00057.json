    "video_id": "00057",
    "start": 610.06,
    "end": 612.06,
    "transcript": "ein bisschen weniger wie in Wien."
  },
  {
    "video_id": "00057",
    "start": 612.06,
    "end": 614.06,
    "transcript": "Es ist jetzt wunderbar."
