  {
    "video_id": "00057",
    "start": 537.58,
    "end": 539.58,
    "transcript": "Spannend war der Endanflug."
  },
  {
    "video_id": "00057",
    "start": 539.58,
    "end": 541.58,
    "transcript": "Wir haben viel beinahe geschaut."
  },
  {
    "video_id": "00057",
    "start": 541.58,
    "end": 543.58,
    "transcript": "Der Endanflug war geil."
