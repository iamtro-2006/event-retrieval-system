    "video_id": "00057",
    "start": 510.92,
    "end": 512.92,
    "transcript": "War super."
  },
  {
    "video_id": "00057",
    "start": 512.92,
    "end": 514.92,
    "transcript": "Jedenfalls 2,62 m, 2,65 m."
