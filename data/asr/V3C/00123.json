  },
  {
    "video_id": "00123",
    "start": 367.15,
    "end": 375.15,
    "transcript": "Can you explain to her fans, to your fans, what is your next plan, your next move for this year?"
  },
  {
    "video_id": "00123",
    "start": 375.15,
    "end": 380.15,
