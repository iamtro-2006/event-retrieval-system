[
  {
    "video_id": "00150",
    "start": 1.78,
    "end": 4.4,
    "transcript": "제주특별자치도 서귀포시."
  },
  {
    "video_id": "00150",
    "start": 6.94,
    "end": 11.42,
    "transcript": "아침 9시가 되자 작은 빵집에 불이 켜집니다."
  },
  {
    "video_id": "00150",
    "start": 13.36,
    "end": 16.26,
    "transcript": "잠시 후 가게 문이 열립니다."
  },
  {
    "video_id": "00150",
    "start": 20.24,
    "end": 24.56,
    "transcript": "유리창 너머 먹음직스러운 빵들이 진열돼 있습니다."
  },
  {
    "video_id": "00150",
    "start": 26.75,
    "end": 30.33,
    "transcript": "빵집을 처음 열어야겠다고 다짐했을 때가"
  },
  {
    "video_id": "00150",
    "start": 30.33,
    "end": 37.88,
    "transcript": "빵이나 케이크를 사러 오는 사람들은 항상 즐거운 마음으로 오거든요."
  },
  {
    "video_id": "00150",
    "start": 37.88,
    "end": 40.5,
    "transcript": "항상 즐거운 분들이 오세요."
  },
  {
    "video_id": "00150",
    "start": 41.38,
    "end": 52.28,
    "transcript": "누구한테 선물하려고 오고 누구한테 마음을 전하려는 상황이라 그런 분들이 되게 좋아요."
  },
  {
    "video_id": "00150",
    "start": 52.4,
    "end": 58.08,
    "transcript": "항상 기분 좋은 분들만 만나고 싶어서 빵집을 열겠다고 다짐했습니다."
  },
  {
    "video_id": "00150",
    "start": 61.53,
    "end": 66.67,
    "transcript": "문을 열자마자 빵집을 찾는 손님들로 가게가 붐빕니다."
  },
  {
    "video_id": "00150",
    "start": 66.67,
    "end": 75.38,
    "transcript": "그런데 주인 김시협씨는 요즘 본인의 꿈이었던"
  },
  {
    "video_id": "00150",
    "start": 75.66,
    "end": 80.66,
    "transcript": "빵집에 일하러 가는 길이 무척 멀게 느껴집니다."
  },
  {
    "video_id": "00150",
    "start": 83.98,
    "end": 89.02,
    "transcript": "며칠 뒤면 김시의 빵집 근처에 대형 프랜차이즈 빵집"
  },
  {
    "video_id": "00150",
    "start": 89.02,
    "end": 92.14,
    "transcript": "파리바게트가 들어오기 때문입니다."
  },
  {
    "video_id": "00150",
    "start": 94.6,
    "end": 97.18,
    "transcript": "거리가 쉰 걸음도 채 되지 않습니다."
  },
  {
    "video_id": "00150",
    "start": 99.82,
    "end": 101.86,
    "transcript": "매장 크기는 두 배가 넘습니다."
  },
  {
    "video_id": "00150",
    "start": 105.04,
    "end": 107.92,
    "transcript": "지금은 인테리어 공사가 한창입니다."
  },
  {
    "video_id": "00150",
    "start": 107.92,
    "end": 115.87,
    "transcript": "새로 열 예정의 대형 빵집 앞에서 김시의 작은 빵집이"
  },
  {
    "video_id": "00150",
    "start": 116.57,
    "end": 117.57,
    "transcript": "보입니다."
  },
  {
    "video_id": "00150",
    "start": 117.57,
    "end": 123.32,
    "transcript": "너무 가까운 거리에 생기는 건 아닌가."
  },
  {
    "video_id": "00150",
    "start": 123.32,
    "end": 129.36,
    "transcript": "조금 거리가 떨어져 있으면은 조금 그나마 좀 덜 할 수도 있는데"
  },
  {
    "video_id": "00150",
    "start": 129.36,
    "end": 136.1,
    "transcript": "지금 체감상으로 너무 가까우니까 길 건너에만 있었어도 좀 괜찮았을 수도 있었는데"
  },
  {
    "video_id": "00150",
    "start": 136.1,
    "end": 139.06,
    "transcript": "너무 같은 라인에 너무 가까운 거리에 생기니까"
  },
  {
    "video_id": "00150",
    "start": 139.06,
    "end": 144.35,
    "transcript": "저희 같은 경우에는 솔직히 어떻게 보면 나가라 이거죠."
  },
  {
    "video_id": "00150",
    "start": 144.35,
    "end": 150.31,
    "transcript": "김씨는 1년 전 이곳에 가게를 열어 이제 겨우 자리를 잡았습니다."
  },
  {
    "video_id": "00150",
    "start": 150.31,
    "end": 151.31,
    "transcript": "김시협씨는 1년 전 이곳에 가게를 열어 이제 겨우 자리를 잡았습니다."
  },
  {
    "video_id": "00150",
    "start": 151.31,
    "end": 152.31,
    "transcript": "김시협씨는 1년 전 이곳에 가게를 열어 이제 겨우 자리를 잡았습니다."
  },
  {
    "video_id": "00150",
    "start": 152.31,
    "end": 160.95,
    "transcript": "나"
  },
  {
    "video_id": "00150",
    "start": 173.65,
    "end": 177.65,
    "transcript": "동반성장위원회의 권고에 따르면 기존 빵집에서 500미터 이내에는"
  },
  {
    "video_id": "00150",
    "start": 177.65,
    "end": 179.13,
    "transcript": "프랜차이즈 빵집이 들어올 수 없습니다."
  },
  {
    "video_id": "00150",
    "start": 179.13,
    "end": 180.39,
    "transcript": "프랜차이즈 빵집이 들어올 수 없습니다."
  },
  {
    "video_id": "00150",
    "start": 180.39,
    "end": 180.67,
    "transcript": "프랜차이즈 빵집이 들어올 수 없습니다."
  },
  {
    "video_id": "00150",
    "start": 182.31,
    "end": 185.41,
    "transcript": "그런데 어떻게 이런 일이 생겼을까요?"
  },
  {
    "video_id": "00150",
    "start": 188.32,
    "end": 192.16,
    "transcript": "김 씨의 빵집 봉주루 마담에서 조금 떨어진 곳에는"
  },
  {
    "video_id": "00150",
    "start": 192.16,
    "end": 197.16,
    "transcript": "또 다른 작은 동네 빵집, 최점석 베이커리가 있습니다."
  },
  {
    "video_id": "00150",
    "start": 199.38,
    "end": 204.38,
    "transcript": "1년 전 최점석 베이커리에 부부로 보이는 손님이 찾아왔습니다."
  },
  {
    "video_id": "00150",
    "start": 204.38,
    "end": 212.86,
    "transcript": "이 손님은 빵을 사는 대신 빵집 주인 최 씨에게 황당한 요구를 했습니다."
  },
  {
    "video_id": "00150",
    "start": 215.9,
    "end": 244.97,
    "transcript": "위장 폐업을 하면 대가를 주겠다는 말로도 들렸습니다."
  },
  {
    "video_id": "00150",
    "start": 244.97,
    "end": 249.57,
    "transcript": "쉽게 돈을 벌 수 있을 것 같았지만"
  },
  {
    "video_id": "00150",
    "start": 249.57,
    "end": 250.45,
    "transcript": "위장 폐업을 하면 대가를 주겠다는 말로도 들렸습니다."
  },
  {
    "video_id": "00150",
    "start": 250.47,
    "end": 256.09,
    "transcript": "30년간 빵만 만든 최 씨에게는 말이 안 되는 소리였습니다."
  },
  {
    "video_id": "00150",
    "start": 260.53,
    "end": 267.89,
    "transcript": "지난 2월 결국 동네 빵집들과 멀리 떨어진 이곳에 파리바게트가 문을 열었습니다."
  },
  {
    "video_id": "00150",
    "start": 270.44,
    "end": 276.92,
    "transcript": "그런데 이상한 건 이곳은 사람들의 왕래가 그렇게 많지 않은 곳이라는 점입니다."
  },
  {
    "video_id": "00150",
    "start": 279.05,
    "end": 283.81,
    "transcript": "버스 종류소가 있지만 지나는 사람들은 거의 보이지 않습니다."
  },
  {
    "video_id": "00150",
    "start": 283.81,
    "end": 315.79,
    "transcript": "이곳 파리바게트는 영업을 시작한 지 1년도 되지 않아 문을 닫았습니다."
  },
  {
    "video_id": "00150",
    "start": 315.79,
    "end": 315.91,
    "transcript": "이곳 파리바게트는 영업을 시작한 지 1년도 되지 않아 문을 닫았습니다."
  },
  {
    "video_id": "00150",
    "start": 316.79,
    "end": 322.13,
    "transcript": "건물주가 임대 계약을 갱신하지 않았다는 이유였습니다."
  },
  {
    "video_id": "00150",
    "start": 324.38,
    "end": 329.66,
    "transcript": "임대차 보호법에 따라 5년까지 영업을 할 수 있도록 보호받을 수 있지만"
  },
  {
    "video_id": "00150",
    "start": 329.66,
    "end": 332.62,
    "transcript": "점주는 이전을 결심했습니다."
  },
  {
    "video_id": "00150",
    "start": 334.93,
    "end": 336.61,
    "transcript": "아주 이례적인 일입니다."
  },
  {
    "video_id": "00150",
    "start": 337.41,
    "end": 344.99,
    "transcript": "1년도 안 돼서 빠질 수가 없죠. 1년이 아니라 3년 안 돼서 빠지는 경우도 거의 있을 수가 없죠."
  },
  {
    "video_id": "00150",
    "start": 345.15,
    "end": 348.61,
    "transcript": "리터리 비용만 해도 얼마가 들어가는데 창업 비용을 감안하면은"
  },
  {
    "video_id": "00150",
    "start": 349.41,
    "end": 350.93,
    "transcript": "쉽게 접지를 못하죠."
  },
  {
    "video_id": "00150",
    "start": 352.93,
    "end": 361.11,
    "transcript": "하지만 건물 관리를 담당하는 매니저는 건물주가 나가라고 했다는 점주의 주장과는 다른 말을 합니다."
  },
  {
    "video_id": "00150",
    "start": 362.93,
    "end": 370.25,
    "transcript": "임대 계약을 6개월에서 1년까지 연장해 주겠다고 했지만 점주가 이를 거부했다는 겁니다."
  },
  {
    "video_id": "00150",
    "start": 370.25,
    "end": 376.88,
    "transcript": "전화를 하신 적이 있어요. 한 2, 3개월 정도는."
  },
  {
    "video_id": "00150",
    "start": 376.88,
    "end": 388.42,
    "transcript": "좀 낮춰드리려고 하는데요."
  },
  {
    "video_id": "00150",
    "start": 388.76,
    "end": 393.43,
    "transcript": "그날 아마 12월 8일 만기하는 날."
  },
  {
    "video_id": "00150",
    "start": 393.59,
    "end": 396.79,
    "transcript": "그날 가는 게 제일 맞는 것 같아요. 어제든."
  },
  {
    "video_id": "00150",
    "start": 397.99,
    "end": 405.95,
    "transcript": "그리고 문을 닫은 파리바게트는 김 씨의 빵집 봉주루 마담 옆으로 이전할 예정입니다."
  },
  {
    "video_id": "00150",
    "start": 407.77,
    "end": 412.85,
    "transcript": "프랜차이즈 제과점의 경우 새로 문을 여는 경우에는 거리 제한이 있지만"
  },
  {
    "video_id": "00150",
    "start": 412.85,
    "end": 419.09,
    "transcript": "점포 임대에 문제가 생겨 옮기는 경우에는 거리 제한이 없어집니다."
  },
  {
    "video_id": "00150",
    "start": 419.09,
    "end": 423.37,
    "transcript": "이제 파리바게트가 바로 옆에 생겨도"
  },
  {
    "video_id": "00150",
    "start": 424.87,
    "end": 428.11,
    "transcript": "파리바게트는 아무런 항변을 할 수 없게 됐습니다."
  },
  {
    "video_id": "00150",
    "start": 428.11,
    "end": 436.13,
    "transcript": "이것을 편법의 헛점을 이용해서 계속 파고드는 것이 아니라"
  },
  {
    "video_id": "00150",
    "start": 436.13,
    "end": 439.29,
    "transcript": "소상공인들은 막을 방법이 없어요."
  },
  {
    "video_id": "00150",
    "start": 439.29,
    "end": 442.49,
    "transcript": "소상공인들이 할 줄 아는 게 빵 만드는 것밖에 없습니다."
  },
  {
    "video_id": "00150",
    "start": 442.49,
    "end": 449.19,
    "transcript": "동반성장위 측도 파리바게트 측이 요건을 다 갖춰왔기 때문에"
  },
  {
    "video_id": "00150",
    "start": 449.19,
    "end": 452.49,
    "transcript": "진입을 규제할 방법은 없다고 합니다."
  },
  {
    "video_id": "00150",
    "start": 452.49,
    "end": 453.49,
    "transcript": "제가 파리바게트의 소명을 받았어요."
