[
  {
    "video_id": "00124",
    "start": 15.57,
    "end": 21.8,
    "transcript": "Jag håller uppe på bockorna först och sitter ute."
  },
  {
    "video_id": "00124",
    "start": 21.8,
    "end": 22.8,
    "transcript": "Tack!"
  },
  {
    "video_id": "00124",
    "start": 54.15,
    "end": 56.15,
    "transcript": "Vi kör på växlade fulltyska."
  },
  {
    "video_id": "00124",
    "start": 61.15,
    "end": 63.15,
    "transcript": "Finns det rätt och fel i den här världen eller?"
  },
  {
    "video_id": "00124",
    "start": 63.15,
    "end": 66.15,
    "transcript": "Det får ni inte gifta. Fulltyska fel."
  },
  {
    "video_id": "00124",
    "start": 66.15,
    "end": 67.15,
    "transcript": "Välkommen åter."
  },
  {
    "video_id": "00124",
    "start": 67.15,
    "end": 68.15,
    "transcript": "Nej, nu är det kallt."
  },
  {
    "video_id": "00124",
    "start": 68.15,
    "end": 70.15,
    "transcript": "Det blir jävligt kul."
  },
  {
    "video_id": "00124",
    "start": 70.15,
    "end": 73.15,
    "transcript": "Det blir kul. Jag har aldrig varit med på det här innan."
  },
  {
    "video_id": "00124",
    "start": 74.15,
    "end": 76.15,
    "transcript": "Det verkar lovande."
  },
  {
    "video_id": "00124",
    "start": 76.15,
    "end": 77.15,
    "transcript": "Håll käften!"
  },
  {
    "video_id": "00124",
    "start": 82.14,
    "end": 84.14,
    "transcript": "Jag har haft koll på den, men sen så..."
  },
  {
    "video_id": "00124",
    "start": 84.14,
    "end": 87.14,
    "transcript": "Om man inte hade några andra planer så blev det att dra ner."
  },
  {
    "video_id": "00124",
    "start": 87.14,
    "end": 88.14,
    "transcript": "Jag hade inte koll på den alls."
  },
  {
    "video_id": "00124",
    "start": 88.14,
    "end": 90.14,
    "transcript": "Han tog och sa, det är mycket cyklar, ska du dra ner?"
  },
  {
    "video_id": "00124",
    "start": 90.14,
    "end": 93.14,
    "transcript": "Låt det då. Så jag bara hoppade på att höja ner."
  },
  {
    "video_id": "00124",
    "start": 95.14,
    "end": 97.14,
    "transcript": "Vad är det grabbar? Var är folk ifrån?"
  },
  {
    "video_id": "00124",
    "start": 97.14,
    "end": 99.14,
    "transcript": "Från hela Sverige?"
  },
  {
    "video_id": "00124",
    "start": 99.14,
    "end": 101.14,
    "transcript": "Smutsiga Söden från Malmö."
  },
  {
    "video_id": "00124",
    "start": 101.14,
    "end": 103.14,
    "transcript": "Smutsiga Söden och Ystad tror jag."
  },
  {
    "video_id": "00124",
    "start": 103.14,
    "end": 105.14,
    "transcript": "Jag har inte helt koll på den."
  },
  {
    "video_id": "00124",
    "start": 105.14,
    "end": 107.14,
    "transcript": "Överrum. Vi har Varberg."
  },
  {
    "video_id": "00124",
    "start": 107.14,
    "end": 108.14,
    "transcript": "Överrum. Vi har Varberg."
  },
  {
    "video_id": "00124",
    "start": 109.14,
    "end": 110.14,
    "transcript": "Det är fett."
  },
  {
    "video_id": "00124",
    "start": 110.14,
    "end": 112.14,
    "transcript": "Skellefteå har vi en också."
