  {
    "video_id": "00197",
    "start": 323.2,
    "end": 326.2,
    "transcript": "Oh, nobody watches C-Span. It's just on in the background."
  },
  {
    "video_id": "00197",
    "start": 326.2,
    "end": 329.2,
    "transcript": "You've got to choose, Paris, because it's becoming pretty clear that this"
  },
