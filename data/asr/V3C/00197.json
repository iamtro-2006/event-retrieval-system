    "video_id": "00197",
    "start": 317.2,
    "end": 321.2,
    "transcript": "He's wandering around, lonely, missing you, scared of losing you,"
  },
  {
    "video_id": "00197",
    "start": 321.2,
    "end": 323.2,
    "transcript": "and you're sitting here watching C-Span."
