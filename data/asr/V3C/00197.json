  {
    "video_id": "00197",
    "start": 423.62,
    "end": 425.62,
    "transcript": "And the tailor said someone already did."
  },
  {
    "video_id": "00197",
    "start": 425.62,
    "end": 429.62,
    "transcript": "And when I asked who, she said she couldn't remember."
