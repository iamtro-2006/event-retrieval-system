  {
    "video_id": "00197",
    "start": 362.2,
    "end": 365.2,
    "transcript": "My grandfather introduced you to him."
  },
  {
    "video_id": "00197",
    "start": 365.2,
    "end": 367.2,
    "transcript": "Do you see how weird this is for me?"
