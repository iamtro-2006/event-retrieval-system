# -----------------------------------------------------------------------------
# Local data and generated pipeline outputs
# -----------------------------------------------------------------------------
# Never commit videos, extracted frames, embeddings, indexes, or diagnostics.
/data/**

# Allow lightweight documentation/placeholders when needed.
!/data/**/
!/data/**/README.md
!/data/**/.gitkeep

# Model weights and runtime artifacts are provisioned locally.
/backend/weights/
/backend/logs/
/logs/
/backend/external/TransNetV2/
*.log

# Common ML model/export artifacts if generated outside backend/weights.
*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.engine

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/

# Virtual environments (the Conda environment lives outside this repository).
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Secrets and local configuration
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
*.local.json

# -----------------------------------------------------------------------------
# Frontend dependencies and generated builds
# -----------------------------------------------------------------------------
node_modules/
.next/
.nuxt/
.svelte-kit/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Editors, operating systems, and temporary files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
