# Local datasets, runtime state, screenshots and Python environment.
/data/
/env/

# Machine-specific settings. Commit .env.example and the public .env.mock instead.
**/.env
**/.env.local
**/.env.*.local

# Generated Python caches and local logs.
**/__pycache__/
*.py[cod]
*.log
.pytest_cache/
.ruff_cache/

# SurgVLP checkpoints are large and subject to upstream non-commercial terms.
backend/weights/*.pth
backend/weights/*.zip

# Isolated local checks for the Kaggle Python 3.11 notebook.
backend/.kaggle-check-tools/
backend/.kaggle-check311/
backend/.venv-mock/
backend/notebooks/.resolve-output.txt
